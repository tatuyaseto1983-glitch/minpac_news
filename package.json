{
  "name": "minpaku-news",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "民泊・簡易宿所・旅館業法のニュースを行政の一次情報からあつめる静的サイト",
  "scripts": {
    "fetch": "node scripts/fetch.mjs",
    "build": "node scripts/build.mjs",
    "update": "npm run fetch && npm run estat && npm run build",
    "preview": "npm run build && node scripts/preview.mjs",
    "serve": "node scripts/serve.mjs",
    "summarize": "node scripts/summarize.mjs",
    "estat": "node scripts/fetch-estat.mjs",
    "test": "node scripts/lib/estat.test.mjs && node scripts/check-workflow.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
